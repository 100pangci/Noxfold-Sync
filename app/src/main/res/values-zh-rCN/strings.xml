    <!-- FirstStartActivity -->

    <!-- Title for dialog displayed on first start -->
    <string name="welcome_title">欢迎使用\nAndroid 版 Syncthing</string>

    <!-- Welcome wizard -->
    <!-- Slide "Introduction" -->
    <string name="welcome_text">Syncthing 是开源的文件同步应用程序。要与其他设备共享数据，您需要将它们的唯一设备 ID 添加到设备列表中。之后，您可以选择要与哪些设备共享哪些文件夹。\n\n如果您遇到任何问题，请通过 GitHub 报告。</string>

    <!-- Slide "Storage Permission" -->
    <string name="storage_permission_title">存储权限</string>
    <string name="storage_permission_desc">Syncthing 需要访问您的存储空间才能进行文件同步。</string>
    <string name="dialog_all_files_access_not_supported">您的设备不支持“所有文件访问权限”</string>

    <!-- Slide "Ignore battery optimizations" -->
    <string name="ignore_doze_permission_title">电池优化</string>
    <string name="ignore_doze_permission_os_notice">已知在 Android TV 上，后台应用偶尔会被系统终止。维基中的“%1$s/%2$s”提供了解决办法。</string>
    <string name="ignore_doze_permission_desc">Android 可能会在一段时间后停止同步。为防止这种情况，请关闭电池优化。一些设备预装了额外的任务终止应用。您也应该将 Syncthing 添加到他们的白名单中。</string>
    <string name="dialog_disable_battery_optimizations_not_supported">您的设备不支持禁用电池优化</string>
    <string name="dialog_confirm_skip_ignore_doze_permission">注意：如果此后 SyncthingNative 被系统中断而出现异常，后果自负。仅当您的设备不支持授予该权限时才可跳过。确定要跳过吗？</string>

    <!-- Slide "Location Permission" -->
    <string name="location_permission_title">位置权限</string>
    <string name="location_permission_desc">Syncthing 可以配置为在选定的 Wi-Fi 网络上工作。Android 要求应用具有获取位置权限才能读取活动的 Wi-Fi 网络名称。如果您想使用此功能，请按上面的按钮。您可以跳过此步骤。有关更多详细信息，请参阅我们的隐私政策。</string>
    <string name="location_permission_desc_api_29">提示：Android 10+ 需选择“始终允许”</string>

    <!-- Slide "Notification Permission" -->
    <string name="notification_permission_title">通知权限</string>
    <string name="notification_permission_desc">需要通知权限来显示新设备连接、文件夹共享请求等通知，并保持服务持续运行。</string>

